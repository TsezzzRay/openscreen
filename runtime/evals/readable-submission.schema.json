{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "model", "reasoningEffort", "instructionHash", "evidenceProtocol", "evidenceCatalogHash", "calibration", "packetCalibration", "scores"],
  "properties": {
    "agent": { "type": "string" },
    "model": { "type": "string" },
    "reasoningEffort": { "type": "string" },
    "instructionHash": { "type": "string" },
    "evidenceProtocol": { "type": "string", "const": "readable-evidence-id-v3" },
    "evidenceCatalogHash": { "type": "string" },
    "calibration": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "status", "reason"],
        "properties": {
          "caseId": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "ungraded"] },
          "reason": { "type": "string" }
        }
      }
    },
    "packetCalibration": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "status", "reason"],
        "properties": {
          "caseId": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "ungraded"] },
          "reason": { "type": "string" }
        }
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trialId", "criterionId", "status", "reason", "rootCause", "evidenceIds"],
        "properties": {
          "trialId": { "type": "string" },
          "criterionId": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "ungraded"] },
          "reason": { "type": "string" },
          "rootCause": { "type": ["string", "null"] },
          "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^e[1-9][0-9]*$" } }
        }
      }
    }
  }
}
